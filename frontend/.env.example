# 복사해서 frontend/.env로 쓴다 (커밋 금지). shop-web이 읽는다 (vite envDir = frontend/).
VITE_SHOP_API_URL=http://localhost:8010
# 쇼핑몰 상단 '상담원 콘솔' 링크가 여는 AXcellent 화면 주소
VITE_DASHBOARD_WEB_URL=http://localhost:3001
# 토스페이먼츠 결제위젯(테스트 모드) 클라이언트 키. test_gck_로 시작하는 클라이언트 키만 넣는다.
# 비우거나 shop-api가 PAYMENT_PROVIDER=toss_test가 아니면 데모 결제로 동작한다. 시크릿 키는 화면 쪽에 두지 않는다(shop-api만)
VITE_TOSS_CLIENT_KEY=
