# shop-api 전용 환경변수 예시. 복사해서 shop-api/.env로 쓴다 (커밋 금지).
# 공통 변수(TENANT_ID, REDIS_URL, LLM_* 등)는 루트 .env에 둔다.

# 1이면 LLM·외부 호출 대신 가짜 응답 (CI는 항상 1)
SHOP_MOCK=

# 이 서비스의 에이전트 토큰 (requester는 토큰에서 꺼낸다)
SHOP_TOKEN=

# 도서관 정보나루(data4library.kr) 인증키. 책 상품 데이터를 만드는 scripts/seed_books.py만 쓴다(판매 서버는 안 읽음).
# backend/.env 또는 이 파일(shop-api/.env)에 둔다. 비우면 스크립트가 멈추고, 이미 만든 시드 파일로는 키 없이 띄울 수 있다.
DATA4LIBRARY_API_KEY=

# 새 번호표(주문·결제 등)의 첫 번호. 새 DB로 바꿀 때 예전 번호와 겹치지 않게 크게(예: 1000000). 비우면 1
# SHOP_ID_START=
